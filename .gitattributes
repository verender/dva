# Netlify Large Media — video/audio go through Git LFS so the git repo
# itself stays small; Netlify stores the actual bytes and serves them via CDN.
# Run `netlify large-media:setup` once (see README) before committing any
# real files matching these patterns.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text
